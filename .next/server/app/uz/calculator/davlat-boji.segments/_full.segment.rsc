11:T11b7,[{"@context":"https://schema.org","@type":"WebPage","name":"Davlat boji","description":"O'zbekistonda davlat boji miqdorini hisoblang. Sud, notarius, ro'yxatga olish va boshqa xizmatlar.","url":"https://calk.uz/uz/calculator/davlat-boji","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/davlat-boji#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/davlat-boji/opengraph-image"},"dateModified":"2026-11-03"},{"@context":"https://schema.org","@type":"WebApplication","name":"Davlat boji","description":"O'zbekistonda davlat boji miqdorini hisoblang. Sud, notarius, ro'yxatga olish va boshqa xizmatlar.","url":"https://calk.uz/uz/calculator/davlat-boji","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/davlat-boji#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"O'zbekiston","item":"https://calk.uz/uz/category/unique"},{"@type":"ListItem","position":3,"name":"Davlat boji","item":"https://calk.uz/uz/calculator/davlat-boji"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Mulkni ro'yxatdan o'tkazish qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Jismoniy shaxslar uchun maydon bo'yicha: 100 m² gacha 1,25 BHK (550 000 so'm), 101-300 m² 2 BHK, 300 dan ortiq 3 BHK. Yuridik shaxslar uchun 5 BHK (2 200 000). Shartnomani notarial tasdiqlash — belgilangan 1 BHK (440 000)."}},{"@type":"Question","name":"Da'vo ariza berish uchun davlat boji qancha?","acceptedAnswer":{"@type":"Answer","text":"Fuqarolik sudlarida mulkiy da'vo summasining 4%, iqtisodiy sudlarda 2%. Minimum — 1 BHK (440 000 so'm). Mehnat nizolari va nafaqa — bepul."}},{"@type":"Question","name":"Kim davlat bojlaridan ozod?","acceptedAnswer":{"@type":"Answer","text":"Mehnat nizolari, aliment, sog'liqqa zarar bo'yicha da'vogarlar va huquqlarini himoya qilayotgan iste'molchilar. 50% chegirma — Ijtimoiy himoya yagona reyestridagi shaxslar va I-II guruh nogironligi bo'lganlar, DXM yoki my.gov.uz orqali. Pensionerlar uchun da'volar bo'yicha chegirma yo'q."}},{"@type":"Question","name":"Nikohni ro'yxatdan o'tkazish qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"0,2 BHK (88 000 so'm). Sud orqali bekor qilish: da'vo 2 BHK (880 000 so'm) va FHDYoda qayd etish 1,5-3 BHK (660 000-1 320 000 so'm). Takroriy nikohda da'vo 4 BHK, qayd etish 3-4 BHK."}},{"@type":"Question","name":"Davlat bojini qanday to'lash mumkin?","acceptedAnswer":{"@type":"Answer","text":"Bank terminallari, Click, Payme, Uzum yoki bank kassasi orqali. Kvitansiya to'lovni tasdiqlaydi (O'RQ-600, 17-modda); elektron to'lovda odatda talab qilinmaydi — to'lov axborot tizimlarida ko'rinadi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Davlat boji","description":"O'zbekistonda davlat boji miqdorini hisoblang. Sud, notarius, ro'yxatga olish va boshqa xizmatlar.","url":"https://calk.uz/uz/calculator/davlat-boji","datePublished":"2025-05-20","dateModified":"2026-11-03","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/davlat-boji"},{"@context":"https://schema.org","@type":"HowTo","name":"Davlat bojidan qanday foydalanish","description":"Davlat bojidan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Xizmat turini tanlang","text":"FHDYo, sud, notarius yoki biznesni ro'yxatdan o'tkazish."},{"@type":"HowToStep","position":2,"name":"Boj summasini oling","text":"Natija darhol chiqadi — davlat boji miqdorini bilib oling."}]}]6:["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13"]}]
