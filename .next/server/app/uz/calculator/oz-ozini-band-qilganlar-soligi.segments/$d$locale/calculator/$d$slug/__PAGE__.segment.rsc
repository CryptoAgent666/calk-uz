2:T1238,[{"@context":"https://schema.org","@type":"WebPage","name":"O'z-o'zini band qilganlar solig'i","description":"O'zbekistonda o'z-o'zini band qilganlar uchun soliqlarni hisoblang. Belgilangan stavka va soddalashtirilgan hisobot.","url":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi/opengraph-image"},"dateModified":"2026-07-25"},{"@context":"https://schema.org","@type":"WebApplication","name":"O'z-o'zini band qilganlar solig'i","description":"O'zbekistonda o'z-o'zini band qilganlar uchun soliqlarni hisoblang. Belgilangan stavka va soddalashtirilgan hisobot.","url":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Soliqlar","item":"https://calk.uz/uz/category/tax"},{"@type":"ListItem","position":3,"name":"O'z-o'zini band qilganlar solig'i","item":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"O'z-o'zini band qilganlik solig'i qancha?","acceptedAnswer":{"@type":"Answer","text":"Aylanmaning 1% (2026-yildan). O'zbekistondagi barcha rejimlar orasida eng past stavka."}},{"@type":"Question","name":"Kim o'z-o'zini band qilgan bo'lishi mumkin?","acceptedAnswer":{"@type":"Answer","text":"Daromadi aylanma solig'i chegarasi — 12 000 BHK (5 280 000 000 so'm) doirasidagi (avvalgi 100 mln so'mlik limit 2026-yildan bekor qilindi), yollama xodimsiz, ruxsat etilgan faoliyat turlari bilan jismoniy shaxslar."}},{"@type":"Question","name":"O'z-o'zini band qilgan YaTTdan nimasi bilan farq qiladi?","acceptedAnswer":{"@type":"Answer","text":"O'z-o'zini band qilgan: 1% soliq, xodimsiz, minimal hisobot. YaTT: 1% soliq, 10 tagacha xodim. Ikkalasi uchun aylanma solig'i chegarasi — 12 000 BHK."}},{"@type":"Question","name":"O'z-o'zini band qilganda pensiya staji boradimi?","acceptedAnswer":{"@type":"Answer","text":"Faqat ixtiyoriy ijtimoiy soliq to'lansa — yiliga kamida 1 BHK (440 000 so'm). Shunda davr stajga qo'shiladi. To'lash majburiyati yo'q, lekin to'lanmasa bu davr uchun staj hisoblanmaydi."}},{"@type":"Question","name":"O'z-o'zini band qilgan sifatida qanday ro'yxatdan o'tish mumkin?","acceptedAnswer":{"@type":"Answer","text":"Mobil ilova yoki my.soliq.uz orqali. Ro'yxatdan o'tish bir necha daqiqa oladi, ofislarga borish shart emas."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"O'z-o'zini band qilganlar solig'i","description":"O'zbekistonda o'z-o'zini band qilganlar uchun soliqlarni hisoblang. Belgilangan stavka va soddalashtirilgan hisobot.","url":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi","datePublished":"2025-02-04","dateModified":"2026-07-25","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/oz-ozini-band-qilganlar-soligi"},{"@context":"https://schema.org","@type":"HowTo","name":"O'z-o'zini band qilganlar solig'idan qanday foydalanish","description":"O'z-o'zini band qilganlar solig'idan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Daromadni kiriting","text":"O'z-o'zini band qilgan shaxsning davr uchun daromadini so'mda kiriting."},{"@type":"HowToStep","position":2,"name":"Hisobni oling","text":"Natija darhol chiqadi: 1% stavka, soliq summasi, o'rtacha oylik soliq va sof daromad."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"MbArIfrPOMzJJrrY6NihS"}
