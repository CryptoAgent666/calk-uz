2:T132d,[{"@context":"https://schema.org","@type":"WebPage","name":"Bazaviy hisoblash miqdori","description":"BHM dan so'mga va aksincha miqdorlarni o'tkazing. O'zbekistonning bazaviy hisoblash miqdorining dolzarb qiymati.","url":"https://calk.uz/uz/calculator/bhm","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/bhm#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/bhm/opengraph-image"},"dateModified":"2026-08-18"},{"@context":"https://schema.org","@type":"WebApplication","name":"Bazaviy hisoblash miqdori","description":"BHM dan so'mga va aksincha miqdorlarni o'tkazing. O'zbekistonning bazaviy hisoblash miqdorining dolzarb qiymati.","url":"https://calk.uz/uz/calculator/bhm","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/bhm#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"O'zbekiston","item":"https://calk.uz/uz/category/unique"},{"@type":"ListItem","position":3,"name":"Bazaviy hisoblash miqdori","item":"https://calk.uz/uz/calculator/bhm"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"2026-yilda 1 BHK qancha?","acceptedAnswer":{"@type":"Answer","text":"440 000 so'm (2026-yil 1-sentabridan amal qiladi, PF-115 Farmoni). Bundan oldin: 412 000 so'm (2025-yil avgust), 375 000 so'm (2024), 330 000 so'm (2023)."}},{"@type":"Question","name":"BHK nima uchun ishlatiladi?","acceptedAnswer":{"@type":"Answer","text":"Jarimalar, davlat bojlari, soliq chegaralari, ijtimoiy nafaqalar, JShShS bo'yicha chegirmalar va boshqa ko'plab normativlarni hisoblash uchun."}},{"@type":"Question","name":"BHK minimal ish haqidan nimasi bilan farq qiladi?","acceptedAnswer":{"@type":"Answer","text":"BHK (440 000 so'm) — normativlar uchun hisob ko'rsatkich. MIH (1 360 000 so'm) — mehnat haqi to'lashning minimal darajasi. 2022-yildan mustaqil belgilanadi."}},{"@type":"Question","name":"BHK qanchalik tez-tez o'zgaradi?","acceptedAnswer":{"@type":"Answer","text":"Odatda yiliga 1-2 marta Prezident Farmoni bilan. Inflyatsiya va iqtisodiy o'sishni hisobga olgan holda indekslanadi."}},{"@type":"Question","name":"QQS chegarasi qancha?","acceptedAnswer":{"@type":"Answer","text":"12 000 BHK — 440 000 so'mlik BHKda 5 280 000 000 so'm. Soliq davri uchun daromad bu summadan oshganda QQS to'lovchisi sifatida ro'yxatdan o'tish majburiy."}},{"@type":"Question","name":"BHK qachon va kim tomonidan tasdiqlanadi?","acceptedAnswer":{"@type":"Answer","text":"BHK (bazaviy hisoblash kattaligi) Prezident Farmoni bilan belgilanadi. Odatda yiliga bir marta avgust-sentabr oylarida indeksatsiya qilinadi. Joriy holat: 2026-yil 1-sentabridan 440 000 so'm (PF-115 Farmoni); bundan oldin 412 000 so'm edi."}},{"@type":"Question","name":"BHK va minimal ish haqi bir xilmi?","acceptedAnswer":{"@type":"Answer","text":"Yo'q, bu ikki turli ko'rsatkich. BHK — soliq, jarima, davlat boji va imtiyozlarni hisoblash uchun. Minimal ish haqi — eng past oylik ish haqi standarti. Ular alohida belgilanadi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Bazaviy hisoblash miqdori","description":"BHM dan so'mga va aksincha miqdorlarni o'tkazing. O'zbekistonning bazaviy hisoblash miqdorining dolzarb qiymati.","url":"https://calk.uz/uz/calculator/bhm","datePublished":"2025-09-09","dateModified":"2026-08-18","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/bhm"},{"@context":"https://schema.org","@type":"HowTo","name":"Bazaviy hisoblash miqdoridan qanday foydalanish","description":"Bazaviy hisoblash miqdoridan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"BHM koeffitsiyentini kiriting","text":"Norma nechta BHM ekanini kiriting — masalan, nikoh boji uchun 0,2."},{"@type":"HowToStep","position":2,"name":"Summani oling","text":"Natija darhol chiqadi: amaldagi BHM bo'yicha so'mdagi summa."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8"],"$L9"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"tiXmGC5WDKODjdEEJHa70"}
