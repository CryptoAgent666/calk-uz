2:T1357,[{"@context":"https://schema.org","@type":"WebPage","name":"Kasallik varaqasi","description":"Kasallik varaqasi to'lovini hisoblang. Xodimning ish staji va o'rtacha ish haqiga bog'liq.","url":"https://calk.uz/uz/calculator/kasallik-varaqasi","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/kasallik-varaqasi#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/kasallik-varaqasi/opengraph-image"},"dateModified":"2026-09-13"},{"@context":"https://schema.org","@type":"WebApplication","name":"Kasallik varaqasi","description":"Kasallik varaqasi to'lovini hisoblang. Xodimning ish staji va o'rtacha ish haqiga bog'liq.","url":"https://calk.uz/uz/calculator/kasallik-varaqasi","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/kasallik-varaqasi#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Ish haqi","item":"https://calk.uz/uz/category/salary"},{"@type":"ListItem","position":3,"name":"Kasallik varaqasi","item":"https://calk.uz/uz/calculator/kasallik-varaqasi"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Kasallik varag'i qanday to'lanadi?","acceptedAnswer":{"@type":"Answer","text":"Sug'urta stajiga qarab: 6 oydan 96 oygacha — 60%, 97 oy va undan ko'p (8 yildan ortiq) — o'rtacha ish haqining 80%. Nafaqa = o'rtacha oylik ish haqi ÷ 25,3 × foiz × yakshanba va bayramlarsiz kasallik kunlari. To'lovlarni olish uchun minimal sug'urta staji — 6 oy."}},{"@type":"Question","name":"Kasallik varag'ini kim to'laydi?","acceptedAnswer":{"@type":"Answer","text":"2026-yil 1-iyuldan: yildagi birinchi 5 kalendar kun — ish beruvchi, 6-kundan — bevosita DSSF (Davlat sug'urta ijtimoiy fondi)."}},{"@type":"Question","name":"Kasallik varag'ining maksimal muddati qancha?","acceptedAnswer":{"@type":"Answer","text":"Yiliga 182 kalendar kungacha. Kasal bolaga qarashda limit 20 kunga (14 yoshgacha bola) yoki 40 kunga (16 yoshgacha nogironligi bo'lgan bola) ko'p. Keyin TIEK qaror qabul qiladi."}},{"@type":"Question","name":"Kasallik varag'i soliqqa tortiladimi?","acceptedAnswer":{"@type":"Answer","text":"Ha, JShShS 12% ushlab qolinadi (IJPH 0,1% badali shu 12% ichida). Ijtimoiy soliq hisoblanmaydi."}},{"@type":"Question","name":"Bolaga qarov uchun kasallik varag'i qanday to'lanadi?","acceptedAnswer":{"@type":"Answer","text":"Oddiy kasallik varag'i kabi, lekin yillik 182 kunlik limit uzaytiriladi: 14 yoshgacha bola uchun 20 kalendar kunga, 16 yoshgacha nogironligi bo'lgan bola uchun 40 kunga."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Kasallik varaqasi","description":"Kasallik varaqasi to'lovini hisoblang. Xodimning ish staji va o'rtacha ish haqiga bog'liq.","url":"https://calk.uz/uz/calculator/kasallik-varaqasi","datePublished":"2025-03-10","dateModified":"2026-09-13","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/kasallik-varaqasi"},{"@context":"https://schema.org","@type":"HowTo","name":"Kasallik varaqasidan qanday foydalanish","description":"Kasallik varaqasidan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"12 oylik daromadni kiriting","text":"Oxirgi 12 oydagi umumiy daromadni kiriting — o'rtacha oylik ish haqini emas. Staj 12 oydan kam bo'lsa — shu oylardagi daromad."},{"@type":"HowToStep","position":2,"name":"Sug'urta stajini ko'rsating","text":"Staj oylarda: 6-96 oy — o'rtacha daromadning 60% i, 97 oydan boshlab — 80%."},{"@type":"HowToStep","position":3,"name":"Kasallik sanalarini ko'rsating","text":"Boshlanish sanasini tanlang va kasallik varaqasidagi taqvim kunlari sonini kiriting — yakshanba va bayramlarni kalkulyator o'zi chiqarib tashlaydi."},{"@type":"HowToStep","position":4,"name":"Hisobni oling","text":"Natija darhol chiqadi: o'rtacha kunlik daromad (÷ 25,3), to'lanadigan kunlar, foiz, ish beruvchi va Jamg'arma ulushlari, nafaqa va JShShS."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"MbArIfrPOMzJJrrY6NihS"}
