2:T12ed,[{"@context":"https://schema.org","@type":"WebPage","name":"Foyda solig'i","description":"Korxona foyda solig'ini hisoblang. O'zbekistonda biznes uchun chegirmalar va imtiyozlarni hisobga olgan holda 15% stavka.","url":"https://calk.uz/uz/calculator/foyda-soligi","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/foyda-soligi#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/foyda-soligi/opengraph-image"},"dateModified":"2026-07-25"},{"@context":"https://schema.org","@type":"WebApplication","name":"Foyda solig'i","description":"Korxona foyda solig'ini hisoblang. O'zbekistonda biznes uchun chegirmalar va imtiyozlarni hisobga olgan holda 15% stavka.","url":"https://calk.uz/uz/calculator/foyda-soligi","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/foyda-soligi#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Soliqlar","item":"https://calk.uz/uz/category/tax"},{"@type":"ListItem","position":3,"name":"Foyda solig'i","item":"https://calk.uz/uz/calculator/foyda-soligi"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Foyda solig'i stavkasi qancha?","acceptedAnswer":{"@type":"Answer","text":"Oddiy yuridik shaxslar uchun 15% (shu jumladan 2026-yildan e-tijorat), banklar, mobil operatorlar, polietilen granulalari ishlab chiqaruvchilar va bozor/savdo majmualari xizmatlaridan olingan foyda uchun 20%, yuqori texnologiyalar asosidagi mahsulot uchun 0% (ZRU-1104 — 3 yil, Prezident ro'yxati bo'yicha). Soddalashtirilda — aylanmadan 4% (yuridik shaxslar), 1% (YaTT va o'z-o'zini band qilganlar)."}},{"@type":"Question","name":"Zararlarni o'tkazish mumkinmi?","acceptedAnswer":{"@type":"Answer","text":"Ha, zararlar muddat cheklovisiz keyingi davrlarga o'tkaziladi (avvalgi 5 yillik limit bekor qilingan), kelajakdagi yillar foydasini kamaytiradi."}},{"@type":"Question","name":"Foyda solig'i bo'yicha qanday imtiyozlar bor?","acceptedAnswer":{"@type":"Answer","text":"EIZ (10 yilgacha ozod qilish), IT Park (tushumdan 1%), ijtimoiy loyihalarga investorlar — pasaytirilgan stavkalar."}},{"@type":"Question","name":"Deklaratsiyani qachon topshirish kerak?","acceptedAnswer":{"@type":"Answer","text":"Tugagan yildan keyingi yilning 1-martidan kechiktirmay (SKning 339-moddasi). Avans to'lovlari — har oy 23-sanasigacha va faqat oldingi davr uchun jami daromadi 20 mlrd so'mdan ortiq bo'lganda (SKning 340-moddasi)."}},{"@type":"Question","name":"Dividendlarga soliq qancha?","acceptedAnswer":{"@type":"Answer","text":"Rezident ta'sischilarga (jismoniy va yuridik shaxslar) to'lanadigan dividendlardan 5%, norezidentlarga — 10%."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Foyda solig'i","description":"Korxona foyda solig'ini hisoblang. O'zbekistonda biznes uchun chegirmalar va imtiyozlarni hisobga olgan holda 15% stavka.","url":"https://calk.uz/uz/calculator/foyda-soligi","datePublished":"2025-08-03","dateModified":"2026-07-25","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/foyda-soligi"},{"@context":"https://schema.org","@type":"HowTo","name":"Foyda solig'idan qanday foydalanish","description":"Foyda solig'idan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Daromadni kiriting","text":"Korxonaning davr uchun daromadini so'mda kiriting."},{"@type":"HowToStep","position":2,"name":"Xarajatlarni ko'rsating","text":"Hujjat bilan tasdiqlangan xarajatlarni kiriting — soliq farqdan hisoblanadi."},{"@type":"HowToStep","position":3,"name":"Stavkani tekshiring","text":"Standart 15% — foyda solig'ining umumiy stavkasi; imtiyozli rejimda uni o'zgartiring."},{"@type":"HowToStep","position":4,"name":"Hisobni oling","text":"Natija darhol chiqadi: foyda, soliq summasi va sof foyda."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
