2:T176f,[{"@context":"https://schema.org","@type":"WebPage","name":"Avto rastamozhka","description":"O'zbekistonda avtomobilni rastamozhka qilish narxini hisoblang. Bojxona boji, aksiz va QQS.","url":"https://calk.uz/uz/calculator/rastamozhka","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/rastamozhka#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/rastamozhka/opengraph-image"},"dateModified":"2026-09-13"},{"@context":"https://schema.org","@type":"WebApplication","name":"Avto rastamozhka","description":"O'zbekistonda avtomobilni rastamozhka qilish narxini hisoblang. Bojxona boji, aksiz va QQS.","url":"https://calk.uz/uz/calculator/rastamozhka","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/rastamozhka#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Avtomobil","item":"https://calk.uz/uz/category/auto"},{"@type":"ListItem","position":3,"name":"Avto rastamozhka","item":"https://calk.uz/uz/calculator/rastamozhka"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Bojxona to'lovlari nimalardan iborat?","acceptedAnswer":{"@type":"Answer","text":"Bojxona boji (0-30%), QQS (qiymat+bojdan 12%), aksiz (aksiz tovarlar uchun), rasmiylashtirish yig'imi (tarif setkasi)."}},{"@type":"Question","name":"Bojsiz qancha tovar olib kirish mumkin?","acceptedAnswer":{"@type":"Answer","text":"2025-yil 1-maydan: samolyotda — $1 000 gacha; poyezdda yoki daryo transportida — $500 gacha; avtomobil (piyoda) o'tkazish punktlari orqali — $300 gacha; xalqaro kuryerlik jo'natmalarida — kalendar oy davomida $200 gacha; xalqaro pochta jo'natmalarida — $100 gacha. Og'irlik bo'yicha umumiy cheklov yo'q. Normalar chet elda kamida 2 kalendar kun (poyezd, daryo transporti, avtomobil o'tkazish punkti) yoki 3 kalendar kun (samolyot) bo'lganda amal qiladi, aks holda to'lov butun qiymatdan olinadi. Normadan ortiq summaga — yagona bojxona to'lovi 30%, lekin 1 kg uchun kamida $3 (2027-yil 1-yanvardan — 20% va 1 kg uchun kamida $2)."}},{"@type":"Question","name":"Bojxona boji miqdorini qanday aniqlash mumkin?","acceptedAnswer":{"@type":"Answer","text":"Tovarning TIF TN kodi bo'yicha. Stavkalar Davlat bojxona qo'mitasi tomonidan e'lon qilinadi."}},{"@type":"Question","name":"Boj hisobi uchun qaysi valyuta kursi ishlatiladi?","acceptedAnswer":{"@type":"Answer","text":"Bojxona deklaratsiyasi topshirilgan sanadagi MB rasmiy kursi."}},{"@type":"Question","name":"Bojxona to'lovlari bo'yicha imtiyozlar bormi?","acceptedAnswer":{"@type":"Answer","text":"Ha: texnologik uskunalar (O'zbekistonda ishlab chiqarilmaydigan), EIZ uchun tovarlar, investitsiya loyihalari."}},{"@type":"Question","name":"BAA dan elektronika olib kirish chegarasi qancha?","acceptedAnswer":{"@type":"Answer","text":"Samolyotda kelganda jismoniy shaxs uchun bojsiz olib kirish normasi — 1 000 AQSh dollari, agar chet elda kamida 3 kalendar kun bo'lgan bo'lsangiz. Og'irlik bo'yicha umumiy cheklov yo'q. Normadan ortiq qismiga yagona bojxona to'lovi olinadi — 30%, lekin 1 kg uchun kamida 3 AQSh dollari (2027-yil 1-yanvardan — 20% va 1 kg uchun kamida 2 dollar). Xalqaro kuryerlik jo'natmalari uchun norma — kalendar oy davomida 200 AQSh dollari, xalqaro pochta jo'natmalari uchun — 100 AQSh dollari."}},{"@type":"Question","name":"Avtomobil rasmiylashtirishda «utilizatsiya yig'imi» qancha?","acceptedAnswer":{"@type":"Answer","text":"Yengil avtomobillar uchun yig'im hajm va ishlab chiqarish yiliga bog'liq: yangi avto uchun 5-15 mln so'm, foydalanilgan uchun ko'proq. Aniq summa zip kalkulyatorda hisoblanadi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Avto rastamozhka","description":"O'zbekistonda avtomobilni rastamozhka qilish narxini hisoblang. Bojxona boji, aksiz va QQS.","url":"https://calk.uz/uz/calculator/rastamozhka","datePublished":"2025-03-20","dateModified":"2026-09-13","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/rastamozhka"},{"@context":"https://schema.org","@type":"HowTo","name":"Avto rastamozhkadan qanday foydalanish","description":"Avto rastamozhkadan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT3M","step":[{"@type":"HowToStep","position":1,"name":"Avtomobil narxini kiriting","text":"Avtomobilning bojxona qiymatini AQSh dollarida kiriting."},{"@type":"HowToStep","position":2,"name":"Dvigatel hajmini ko'rsating","text":"Dvigatel hajmini kub santimetrlarda kiriting."},{"@type":"HowToStep","position":3,"name":"Yoqilg'i turini tanlang","text":"Benzin, dizel, elektro yoki gibrid — stavkalar va utilizatsiya yig'imi shunga bog'liq."},{"@type":"HowToStep","position":4,"name":"Avtomobil yoshini ko'rsating","text":"1 yilgacha, 1 yildan 3 yilgacha yoki 3 yildan katta — boj stavkalari shu guruhlar bo'yicha farq qiladi."},{"@type":"HowToStep","position":5,"name":"Bojlar hisobini oling","text":"Natija darhol chiqadi — bojxona boji, QQS, utilizatsiya yig'imi, ro'yxatga olish va jami."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"MbArIfrPOMzJJrrY6NihS"}
