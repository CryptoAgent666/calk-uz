2:T12f9,[{"@context":"https://schema.org","@type":"WebPage","name":"Avtoni hisobga qo'yish: davlat bojlari","description":"O'zbekistonda transport solig'i yo'q. Haqiqatda to'lanadigan narsani hisoblaymiz — avtomobilni hisobga qo'yishdagi davlat bojlari.","url":"https://calk.uz/uz/calculator/transport-soligi","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/transport-soligi#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/transport-soligi/opengraph-image"},"dateModified":"2026-08-09"},{"@context":"https://schema.org","@type":"WebApplication","name":"Avtoni hisobga qo'yish: davlat bojlari","description":"O'zbekistonda transport solig'i yo'q. Haqiqatda to'lanadigan narsani hisoblaymiz — avtomobilni hisobga qo'yishdagi davlat bojlari.","url":"https://calk.uz/uz/calculator/transport-soligi","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/transport-soligi#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Avtomobil","item":"https://calk.uz/uz/category/auto"},{"@type":"ListItem","position":3,"name":"Avtoni hisobga qo'yish: davlat bojlari","item":"https://calk.uz/uz/calculator/transport-soligi"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"O‘zbekistonda transport solig‘i qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Hech qancha — bunday soliq O‘zbekistonda mavjud emas. Soliq kodeksining 17-moddasidagi ro‘yxat yopiq va unda transport solig‘i yo‘q. Avtomobilga egalik uchun yillik to‘lov yo‘q."}},{"@type":"Question","name":"Avtomobilni hisobga qo‘yish qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Yangi raqam bilan 13,04 BHM = 5 372 480 so‘m: ro‘yxatga olish 6,84 BHM, texpasport 0,7 BHM, raqamlar 5,5 BHM. O‘z raqamlari bilan — 7,54 BHM (3 106 480 so‘m)."}},{"@type":"Question","name":"Elektromobillar soliqqa tortiladimi?","acceptedAnswer":{"@type":"Answer","text":"Yillik soliq na elektromobillar, na ichki yonuv dvigatelli avtomobillar uchun yo‘q. Olib kelishda elektromobil bojxona boji va aksizdan ozod, lekin utilizatsiya yig‘imini to‘laydi — yoshiga qarab 120 yoki 210 BHM."}},{"@type":"Question","name":"Unda 15-aprel va 15-oktabrgacha nima to‘lanadi?","acceptedAnswer":{"@type":"Answer","text":"Bu jismoniy shaxslarning mol-mulk solig‘i va yer solig‘i muddatlari. Avtomobil ularning obyekti emas."}},{"@type":"Question","name":"Avtomobil sotilganda to‘lash kerakmi?","acceptedAnswer":{"@type":"Answer","text":"Yillik soliq yo‘q, shuning uchun uni sotuvchi va xaridor o‘rtasida bo‘lish shart emas. Yangi egasi qayta ro‘yxatga olish uchun davlat bojini to‘laydi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Avtoni hisobga qo'yish: davlat bojlari","description":"O'zbekistonda transport solig'i yo'q. Haqiqatda to'lanadigan narsani hisoblaymiz — avtomobilni hisobga qo'yishdagi davlat bojlari.","url":"https://calk.uz/uz/calculator/transport-soligi","datePublished":"2025-01-19","dateModified":"2026-08-09","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/transport-soligi"},{"@context":"https://schema.org","@type":"HowTo","name":"Avtoni hisobga qo'yish: davlat bojlaridan qanday foydalanish","description":"Avtoni hisobga qo'yish: davlat bojlaridan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"TV turini tanlang","text":"Yengil avtomobil, mototsikl yoki tirkama — davlat boji stavkalari har xil."},{"@type":"HowToStep","position":2,"name":"Yangi raqam kerakmi, belgilang","text":"O'z raqamlari bilan qayta ro'yxatdan o'tishda to'lov 5,5 BHM ga kam."},{"@type":"HowToStep","position":3,"name":"Hisobni oling","text":"Natija darhol chiqadi — hisobga qo'yishdagi bir martalik davlat boji, so'mda va BHM da."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8"],"$L9"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"P-2DZAOPRQ-rO-i26Mm8B"}
