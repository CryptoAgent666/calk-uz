2:T11bf,[{"@context":"https://schema.org","@type":"WebPage","name":"Suv","description":"Sovuq va issiq suv narxini hududingiz tariflari bo'yicha hisoblang — kanalizatsiya va markaziy issiq suv ta'minoti bilan yoki ularsiz.","url":"https://calk.uz/uz/calculator/suv","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/suv#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/suv/opengraph-image"},"dateModified":"2026-09-10"},{"@context":"https://schema.org","@type":"WebApplication","name":"Suv","description":"Sovuq va issiq suv narxini hududingiz tariflari bo'yicha hisoblang — kanalizatsiya va markaziy issiq suv ta'minoti bilan yoki ularsiz.","url":"https://calk.uz/uz/calculator/suv","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/suv#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"Kommunal","item":"https://calk.uz/uz/category/utilities"},{"@type":"ListItem","position":3,"name":"Suv","item":"https://calk.uz/uz/calculator/suv"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"O'zbekistonda suv qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Hududga bog'liq. QQS bilan ichimlik suvi Toshkentda m³ uchun 1 568 so'mdan Surxondaryo viloyatida 7 616 so'mgacha, oqova suv — 728 dan 4 256 so'mgacha. Suv va kanalizatsiya birgalikda m³ uchun 2 688 dan 11 256 so'mgacha turadi."}},{"@type":"Question","name":"Hisoblagich bo'yicha to'lash foydaliroqmi?","acceptedAnswer":{"@type":"Answer","text":"Odatda ha, va sezilarli darajada: hisoblagichsiz suv normativiga 1,5 oshiruvchi koeffitsiyent qo'llaniladi. Toshkentda issiq suv ta'minoti bor uyda 4 kishilik oila normativ bo'yicha oyiga 195 543 so'm, hisoblagich bilan 10 m³ sarfda esa 38 080 so'm to'laydi."}},{"@type":"Question","name":"Hisoblagichsiz suv iste'moli normativi qancha?","acceptedAnswer":{"@type":"Answer","text":"Suv quvuri ulangan uyda bir kishiga kuniga 350 litr, jadval asosida suv berilganda 200, ko'cha kolonkasida 50 litr (Vazirlar Mahkamasining 15.07.2014-yildagi 194-son qarori). Hisoblagichsiz suv normativi 1,5 ga ko'paytiriladi."}},{"@type":"Question","name":"Suv hisoblagich ko'rsatkichlarini qanday uzatish mumkin?","acceptedAnswer":{"@type":"Answer","text":"Suv kanali mobil ilovasi yoki abonent bo'limi orqali. Ko'rsatkichlar har oy uzatiladi."}},{"@type":"Question","name":"Suv hisoblagichni o'rnatish qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"O'rnatish bilan 200 000-500 000 so'm. Tekshirish har 4-6 yilda. 3-6 oyda o'zini oqlaydi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Suv","description":"Sovuq va issiq suv narxini hududingiz tariflari bo'yicha hisoblang — kanalizatsiya va markaziy issiq suv ta'minoti bilan yoki ularsiz.","url":"https://calk.uz/uz/calculator/suv","datePublished":"2025-05-15","dateModified":"2026-09-10","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/suv"},{"@context":"https://schema.org","@type":"HowTo","name":"Suvdan qanday foydalanish","description":"Suvdan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Sovuq suv sarfini kiriting","text":"Oylik iste'molni kub metrda ko'rsating."},{"@type":"HowToStep","position":2,"name":"Issiq suv sarfini kiriting","text":"Issiq suv alohida, yuqoriroq tarif bo'yicha hisoblanadi."},{"@type":"HowToStep","position":3,"name":"To'lov summasini oling","text":"Natija darhol chiqadi: har bir suv turi bo'yicha summa va jami."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
