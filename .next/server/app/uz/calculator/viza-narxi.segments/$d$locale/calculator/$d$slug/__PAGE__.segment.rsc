2:T130e,[{"@context":"https://schema.org","@type":"WebPage","name":"Viza narxi","description":"O'zbekiston fuqarolari uchun viza narxini hisoblang. Konsullik yig'imi, sug'urta va servis yig'imi.","url":"https://calk.uz/uz/calculator/viza-narxi","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/viza-narxi#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/viza-narxi/opengraph-image"},"dateModified":"2026-11-03"},{"@context":"https://schema.org","@type":"WebApplication","name":"Viza narxi","description":"O'zbekiston fuqarolari uchun viza narxini hisoblang. Konsullik yig'imi, sug'urta va servis yig'imi.","url":"https://calk.uz/uz/calculator/viza-narxi","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/viza-narxi#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"O'zbekiston","item":"https://calk.uz/uz/category/unique"},{"@type":"ListItem","position":3,"name":"Viza narxi","item":"https://calk.uz/uz/calculator/viza-narxi"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Shengen vizasi qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Konsullik yig'imi €90 va viza markazining servis yig'imi €20-30, foto, hujjatlar tarjimasi hamda sug'urta. So'mdagi aniq summani kalkulyator MBning joriy yevro kursi bo'yicha hisoblaydi."}},{"@type":"Question","name":"Qaysi mamlakatlarga viza kerak emas?","acceptedAnswer":{"@type":"Answer","text":"Jumladan Rossiya, Qozog'iston, Qirg'iziston, Tojikiston, Gruziya, Turkiya, BAA, Malayziya va Xitoy (bir kirishda 30 kungacha). Janubiy Koreya va Singapurga viza kerak. Muddatlarni yuqorida ko'ring, safardan oldin elchixona saytida tekshiring."}},{"@type":"Question","name":"Viza narxi nimalardan tashkil topadi?","acceptedAnswer":{"@type":"Answer","text":"Konsullik yig'imi (Yaponiyada noldan AQShda $185 gacha) + viza markazi servis yig'imi (€20-30) + foto (30 000-50 000 so'm) + hujjatlar tarjimasi (200 000-500 000 so'm) + tibbiy sug'urta (200 000-800 000 so'm)."}},{"@type":"Question","name":"Toshkentda viza uchun hujjatlarni qayerga topshirish mumkin?","acceptedAnswer":{"@type":"Answer","text":"Mamlakatga bog'liq: Janubiy Koreya — faqat akkreditatsiyalangan agentliklar orqali, Yaponiya — elchixonada qog'ozda, yozilib, Shengen mamlakatlari — tegishli mamlakatning viza markazi orqali. Dolzarb manzilni konsullik saytida ko'ring."}},{"@type":"Question","name":"Bolalar uchun viza qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Shengen: 6 yoshgacha bolalar — bepul, 6-12 yosh — €45 (~600 000 so'm). AQSh (B1/B2): barcha yoshdagilar uchun bir xil $185. Servis yig'imi va sug'urta yoshdan qat'i nazar to'lanadi."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Viza narxi","description":"O'zbekiston fuqarolari uchun viza narxini hisoblang. Konsullik yig'imi, sug'urta va servis yig'imi.","url":"https://calk.uz/uz/calculator/viza-narxi","datePublished":"2025-07-26","dateModified":"2026-11-03","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/viza-narxi"},{"@context":"https://schema.org","@type":"HowTo","name":"Viza narxidan qanday foydalanish","description":"Viza narxidan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Mamlakatni tanlang","text":"Shengen, AQSH, Buyuk Britaniya, Janubiy Koreya, Yaponiya; Turkiya, BAA va 30 kungacha Xitoyga viza kerak emas."},{"@type":"HowToStep","position":2,"name":"Sug'urta muddatini ko'rsating","text":"Safar kunlari soni — tibbiy sug'urta shundan hisoblanadi."},{"@type":"HowToStep","position":3,"name":"Hisobni oling","text":"Natija darhol chiqadi: MB kursi bo'yicha konsullik va xizmat yig'imlari, sug'urta, fotosurat va jami. AQSH uchun mumkin bo'lgan Visa Integrity Fee alohida qatorda ko'rsatiladi, jamiga kirmaydi."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7"],"$L8"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"e0E8JYI6j2UTXjDmQdq0S"}
