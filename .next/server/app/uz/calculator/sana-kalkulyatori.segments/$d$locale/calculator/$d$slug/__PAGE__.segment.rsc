f:["$","div",null,{"className":"mt-10","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-foreground mb-4","children":"Kalkulyatordan qanday foydalanish"}],["$","div",null,{"className":"prose prose-sm sm:prose-base max-w-none text-muted-foreground space-y-4","children":[["$","div","0",{"children":[["$","h3",null,{"className":"text-lg font-semibold text-foreground mt-6 mb-2","children":"Kalkulyator qanday ishlaydi"}],["$","p",null,{"className":"leading-relaxed","children":[["$","$1","0",{"children":"Sana kalkulyatori ikki sana orasidagi farqni hisoblaydi: yillar, oylar, kunlar, haftalar, barcha kalendar kunlar va ish kunlari. Vosita shartnomalar, to'lov jadvallari, kadrlar hisobi va tadbirlarni rejalashtirishda foydali. Hisob-kitoblar kabisa yillarini hisobga olib, grigoriy taqvimi bo'yicha olib boriladi."}]]}]]}],["$","div","1",{"children":[["$","h3",null,{"className":"text-lg font-semibold text-foreground mt-6 mb-2","children":"Hisoblash formulasi"}],["$","p",null,{"className":"leading-relaxed","children":[["$","$1","0",{"children":"O'zbekistonda undan shartnoma va kontrakt muddatlarini tekshirishda foydalaniladi. Muddatning oxirgi kuni ishlanmaydigan kunga to'g'ri kelsa, odatda keyingi eng yaqin ish kuni tugash kuni hisoblanadi. Kalkulyatordagi ish kunlari — dushanba-juma: davlat bayramlari va olti kunlik hafta hisobga olinmaydi, bunday sanalarni ishlab chiqarish taqvimi bo'yicha tekshiring."}]]}]]}],["$","div","2",{"children":[["$","h3",null,{"className":"text-lg font-semibold text-foreground mt-6 mb-2","children":"Hisoblash misoli"}],["$","p",null,{"className":"leading-relaxed","children":[["$","$1","0",{"children":"Biznes uchun amaliy qo'llanilishi: hisob-faktura bo'yicha 30 kunlik to'lov muddatini tekshirish, tovar kafolat muddatining qolgan qismini aniqlash, penya uchun kechikish davrini belgilash. Masalan, kabisa bo'lmagan yilda 15-yanvar va 15-aprel orasida 90 kalendar kun o'tadi: shunday qilib shartnoma muddatga sig'ganini tekshirish mumkin."}]]}]]}],["$","div","3",{"children":[["$","h3",null,{"className":"text-lg font-semibold text-foreground mt-6 mb-2","children":"Nimalarni hisobga olish kerak"}],["$","p",null,{"className":"leading-relaxed","children":[["$","$1","0",{"children":"Kadrlar xizmati uchun vosita xodimlar stajini va bola parvarishi ta'tili davomiyligini hisoblashda foydali. Mehnat kodeksiga ko'ra sinov muddati uch oydan oshmasligi kerak: ishga qabul sanasi va kerakli sana orasidagi farqni shu yerda osongina tekshirish mumkin."}]]}]]}],["$","div","4",{"children":[["$","h3",null,{"className":"text-lg font-semibold text-foreground mt-6 mb-2","children":"Foydali maslahatlar"}],["$","p",null,{"className":"leading-relaxed","children":[["$","$1","0",{"children":"Kundalik hayotda kalkulyator muhim voqeagacha — to'y, imtihon, Navro'z (21-mart) yoki Mustaqillik kuni (1-sentabr) gacha qancha kun qolganini bilishga yordam beradi. Sanaga kun qo'shishni bilmaydi, lekin istalgan ikki sana orasidagi farqni kabisa yillari va oylarning turli uzunligini hisobga olib hisoblaydi."}]]}]]}]]}],null,["$","div",null,{"className":"mt-8","children":[["$","h3",null,{"className":"text-lg sm:text-xl font-semibold text-foreground mb-4","children":"Ko'p beriladigan savollar"}],["$","$L15",null,{"className":"rounded-xl border border-border bg-card px-4","children":[["$","$L16","0",{"value":"faq-0","children":[["$","$L17",null,{"className":"text-left text-foreground","children":"Sanalar o'rtasidagi farqni qanday bilish mumkin?"}],["$","$L18",null,{"children":["$","p",null,{"className":"text-muted-foreground","children":"Ikkita sanani kiriting — kalkulyator kunlar, haftalar, oylar va yillardagi farqni ko'rsatadi."}]}]]}],["$","$L16","1",{"value":"faq-1","children":[["$","$L17",null,{"className":"text-left text-foreground","children":"Kabisa yillari hisobga olinadimi?"}],["$","$L18",null,{"children":"$L19"}]]}],"$L1a"]}]]}],"$L1b"]}]
