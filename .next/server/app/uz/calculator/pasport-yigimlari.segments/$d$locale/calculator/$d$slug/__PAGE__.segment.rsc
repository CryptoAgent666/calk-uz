2:T15c0,[{"@context":"https://schema.org","@type":"WebPage","name":"Pasport yig'imlari","description":"O'zbekiston ID-kartasi va xorijga chiqish pasporti uchun davlat bojini hisoblang — kattalar va bolalar uchun, almashtirish va yo'qotishda, my.gov.uz orqali arizada.","url":"https://calk.uz/uz/calculator/pasport-yigimlari","inLanguage":"uz","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/uz/calculator/pasport-yigimlari#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/uz/calculator/pasport-yigimlari/opengraph-image"},"dateModified":"2026-09-21"},{"@context":"https://schema.org","@type":"WebApplication","name":"Pasport yig'imlari","description":"O'zbekiston ID-kartasi va xorijga chiqish pasporti uchun davlat bojini hisoblang — kattalar va bolalar uchun, almashtirish va yo'qotishda, my.gov.uz orqali arizada.","url":"https://calk.uz/uz/calculator/pasport-yigimlari","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"uz","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/uz/calculator/pasport-yigimlari#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Bosh sahifa","item":"https://calk.uz/uz"},{"@type":"ListItem","position":2,"name":"O'zbekiston","item":"https://calk.uz/uz/category/unique"},{"@type":"ListItem","position":3,"name":"Pasport yig'imlari","item":"https://calk.uz/uz/calculator/pasport-yigimlari"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"2026-yilda xorijga chiqish pasporti qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"1 BHM = 440 000 so'm, 16 yoshgacha bolaga — BHMning 80 foizi = 352 000 so'm (O'RQ-600, ilova, 6-band «b», «v»). my.gov.uz orqali — 90 foizi: 396 000 va 316 800 so'm. Tayyorlanish — 10 ish kuni; qo'shimcha haq evaziga shoshilinch rasmiylashtirish yo'q."}},{"@type":"Question","name":"ID-karta qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"BHMning 89 foizi = 391 600 so'm — kattalar va bolalar, jumladan yangi tug'ilganlar uchun bir xil (O'RQ-600, ilova, 6-band «a»). Bir ish kunida beriladi. Amal qilish muddati 16 yoshdan — 10 yil, bir yoshdan 16 yoshgacha — 5 yil, bir yoshgacha — 2 yil."}},{"@type":"Question","name":"Pasport yo'qotilganda qancha turadi?","acceptedAnswer":{"@type":"Answer","text":"Odatdagidek: qonun yo'qotish uchun oshirilgan boj belgilamagan. ID-karta — 391 600 so'm, xorijga chiqish pasporti — 440 000 so'm (16 yoshgacha — 352 000). Favqulodda vaziyat va yong'indan jabrlanganlar, yolg'iz keksalar va parvarishga muhtoj nogironligi bo'lgan shaxslar yangisini bepul oladi (O'RQ-600, 13-modda)."}},{"@type":"Question","name":"Pasportni qayerda rasmiylashtirish mumkin?","acceptedAnswer":{"@type":"Answer","text":"ID-kartani — propiskadan qat'i nazar istalgan IIB migratsiya bo'linmasida yoki davlat xizmatlari markazida. Xorijga chiqish pasportini — my.gov.uz orqali yoki istalgan ma'lumotlarni yig'ish punktida shaxsan. To'lov — bankda, Click, Payme, Uzum orqali yoki my.gov.uz dagi invoys bo'yicha."}},{"@type":"Question","name":"Xorijga chiqish pasporti uchun qanday hujjatlar kerak?","acceptedAnswer":{"@type":"Answer","text":"So'rovnoma va ID-karta yoki biometrik pasport — alohida hollardan tashqari boshqa hujjat talab qilinmaydi (PQ-4079 Nizomining 22-bandi). Surat va barmoq izlari joyida olinadi. Bolaga — ota-ona roziligi; my.gov.uz orqali berilganda elektron raqamli imzo bilan, notariussiz."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Pasport yig'imlari","description":"O'zbekiston ID-kartasi va xorijga chiqish pasporti uchun davlat bojini hisoblang — kattalar va bolalar uchun, almashtirish va yo'qotishda, my.gov.uz orqali arizada.","url":"https://calk.uz/uz/calculator/pasport-yigimlari","datePublished":"2025-08-02","dateModified":"2026-09-21","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/uz/author/konstantin-yakovlev","jobTitle":"Calk.UZ loyihasi asoschisi va rahbari","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"uz","mainEntityOfPage":"https://calk.uz/uz/calculator/pasport-yigimlari"},{"@context":"https://schema.org","@type":"HowTo","name":"Pasport yig'imlaridan qanday foydalanish","description":"Pasport yig'imlaridan foydalanish bo'yicha qadam-baqadam qo'llanma","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Hujjatni tanlang","text":"ID-karta (kattalar va bolalar uchun stavka bir xil), 16 yoshdan xorijga chiqish pasporti yoki 16 yoshgacha bolaga xorijga chiqish pasporti."},{"@type":"HowToStep","position":2,"name":"Sabab va ariza usulini ko'rsating","text":"Birinchi marta, almashtirish yoki yo'qotish — boj bir xil. Xorijga chiqish pasporti uchun my.gov.uz orqali arizani belgilang: bunda bojning 90 foizi to'lanadi."},{"@type":"HowToStep","position":3,"name":"Hisobni oling","text":"Natija darhol chiqadi: BHMdagi stavka, to'lanadigan summa va tayyorlanish muddati ish kunlarida."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
