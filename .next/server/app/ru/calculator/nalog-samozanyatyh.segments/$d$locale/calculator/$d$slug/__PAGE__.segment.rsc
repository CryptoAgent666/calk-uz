2:T1587,[{"@context":"https://schema.org","@type":"WebPage","name":"Налог самозанятых","description":"Рассчитайте налоги для самозанятых в Узбекистане. Фиксированная ставка и упрощённая отчётность.","url":"https://calk.uz/ru/calculator/nalog-samozanyatyh","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/nalog-samozanyatyh#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/nalog-samozanyatyh/opengraph-image"},"dateModified":"2026-07-25"},{"@context":"https://schema.org","@type":"WebApplication","name":"Налог самозанятых","description":"Рассчитайте налоги для самозанятых в Узбекистане. Фиксированная ставка и упрощённая отчётность.","url":"https://calk.uz/ru/calculator/nalog-samozanyatyh","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/nalog-samozanyatyh#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Налоги","item":"https://calk.uz/ru/category/tax"},{"@type":"ListItem","position":3,"name":"Налог самозанятых","item":"https://calk.uz/ru/calculator/nalog-samozanyatyh"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Какой налог у самозанятого?","acceptedAnswer":{"@type":"Answer","text":"1% от оборота (с 2026 года). Самая низкая ставка среди всех режимов в Узбекистане."}},{"@type":"Question","name":"Кто может стать самозанятым?","acceptedAnswer":{"@type":"Answer","text":"Физические лица с доходом в пределах порога налога с оборота — 12 000 БРВ (5 280 000 000 сум) (прежний лимит 100 млн сум отменён с 2026 года), без наёмных работников, с разрешёнными видами деятельности."}},{"@type":"Question","name":"Чем самозанятый отличается от ИП?","acceptedAnswer":{"@type":"Answer","text":"Самозанятый: 1% налог, без работников, минимум отчётности. ИП: 1% налог, до 10 работников. Порог налога с оборота для обоих — 12 000 БРВ."}},{"@type":"Question","name":"Идёт ли пенсионный стаж у самозанятого?","acceptedAnswer":{"@type":"Answer","text":"Только если платить добровольный социальный налог — минимум 1 БРВ в год (440 000 сум). Тогда период засчитывается в стаж. Обязанности платить нет, но без уплаты стаж за это время не начисляется."}},{"@type":"Question","name":"Как зарегистрироваться самозанятым?","acceptedAnswer":{"@type":"Answer","text":"Через мобильное приложение или my.soliq.uz. Регистрация занимает несколько минут, без посещения офисов."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Налог самозанятых","description":"Рассчитайте налоги для самозанятых в Узбекистане. Фиксированная ставка и упрощённая отчётность.","url":"https://calk.uz/ru/calculator/nalog-samozanyatyh","datePublished":"2025-02-04","dateModified":"2026-07-25","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/nalog-samozanyatyh"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Налог самозанятых","description":"Пошаговое руководство по использованию калькулятора: Налог самозанятых","totalTime":"PT2M","step":[{"@type":"HowToStep