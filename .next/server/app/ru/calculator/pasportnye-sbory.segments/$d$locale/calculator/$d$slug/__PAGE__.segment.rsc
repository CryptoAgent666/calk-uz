2:T1b44,[{"@context":"https://schema.org","@type":"WebPage","name":"Паспортные сборы","description":"Рассчитайте госпошлину за ID-карту и загранпаспорт Узбекистана — для взрослых и детей, при замене и утере, при подаче через my.gov.uz.","url":"https://calk.uz/ru/calculator/pasportnye-sbory","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/pasportnye-sbory#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/pasportnye-sbory/opengraph-image"},"dateModified":"2026-09-21"},{"@context":"https://schema.org","@type":"WebApplication","name":"Паспортные сборы","description":"Рассчитайте госпошлину за ID-карту и загранпаспорт Узбекистана — для взрослых и детей, при замене и утере, при подаче через my.gov.uz.","url":"https://calk.uz/ru/calculator/pasportnye-sbory","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/pasportnye-sbory#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Узбекистан","item":"https://calk.uz/ru/category/unique"},{"@type":"ListItem","position":3,"name":"Паспортные сборы","item":"https://calk.uz/ru/calculator/pasportnye-sbory"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит загранпаспорт в 2026 году?","acceptedAnswer":{"@type":"Answer","text":"1 БРВ = 440 000 сум, ребёнку до 16 лет — 80% БРВ = 352 000 сум (ЗРУ-600, приложение, п. 6 «б», «в»). При подаче через my.gov.uz — 90%: 396 000 и 316 800 сум. Изготовление — 10 рабочих дней; срочного оформления за доплату нет."}},{"@type":"Question","name":"Сколько стоит ID-карта?","acceptedAnswer":{"@type":"Answer","text":"89% БРВ = 391 600 сум — одинаково для взрослых и детей, включая новорождённых (ЗРУ-600, приложение, п. 6 «а»). Выдаётся за один рабочий день. Срок действия с 16 лет — 10 лет, от года до 16 лет — 5 лет, до года — 2 года."}},{"@type":"Question","name":"Сколько стоит паспорт при утере?","acceptedAnswer":{"@type":"Answer","text":"Столько же, сколько обычно: повышенной пошлины за утерю закон не устанавливает. ID-карта — 391 600 сум, загранпаспорт — 440 000 сум (до 16 лет — 352 000). Пострадавшие от ЧС и пожаров, одинокие престарелые и лица с инвалидностью, нуждающиеся в уходе, получают замену бесплатно (ст. 13 ЗРУ-600)."}},{"@type":"Question","name":"Где оформить паспорт?","acceptedAnswer":{"@type":"Answer","text":"ID-карту — в любом подразделении миграции ОВД или центре госуслуг, независимо от прописки. Загранпаспорт — через my.gov.uz или лично в любом пункте сбора данных. Оплата — в банке, через Click, Payme, Uzum или по счёту в my.gov.uz."}},{"@type":"Question","name":"Какие документы нужны для загранпаспорта?","acceptedAnswer":{"@type":"Answer","text":"Анкета и ID-карта или биометрический паспорт — других документов, кроме особых случаев, требовать не вправе (п. 22 Положения, ПП-4079). Фото и отпечатки пальцев снимают на месте. Для ребёнка — согласие родителей; при подаче через my.gov.uz — электронной подписью, без нотариуса."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Паспортные сборы","description":"Рассчитайте госпошлину за ID-карту и загранпаспорт Узбекистана — для взрослых и детей, при замене и утере, при подаче через my.gov.uz.","url":"https://calk.uz/ru/calculator/pasportnye-sbory","datePublished":"2025-08-02","dateModified":"2026-09-21","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/pasportnye-sbory"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Паспортные сборы","description":"Пошаговое руководство по использованию калькулятора: Паспортные сборы","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Выберите документ","text":"ID-карта (ставка одна для взрослых и детей), загранпаспорт с 16 лет или загранпаспорт ребёнку до 16 лет."},{"@type":"HowToStep","position":2,"name":"Укажите причину и способ подачи","text":"Первичное оформление, замена или утеря — пошлина одна и та же. Для загранпаспорта отметьте подачу через my.gov.uz: в этом случае платится 90% пошлины."},{"@type":"HowToStep","position":3,"name":"Получите расчёт","text":"Результат появится сразу: ставка в БРВ, сумма к оплате и срок изготовления в рабочих днях."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
