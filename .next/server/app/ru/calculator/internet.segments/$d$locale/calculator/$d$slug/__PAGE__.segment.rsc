2:T13f7,[{"@context":"https://schema.org","@type":"WebPage","name":"Интернет","description":"Сравните тарифы интернет-провайдеров Узбекистана. Найдите оптимальный тариф по скорости и цене.","url":"https://calk.uz/ru/calculator/internet","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/internet#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/internet/opengraph-image"},"dateModified":"2025-09-05"},{"@context":"https://schema.org","@type":"WebApplication","name":"Интернет","description":"Сравните тарифы интернет-провайдеров Узбекистана. Найдите оптимальный тариф по скорости и цене.","url":"https://calk.uz/ru/calculator/internet","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/internet#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Коммунальные","item":"https://calk.uz/ru/category/utilities"},{"@type":"ListItem","position":3,"name":"Интернет","item":"https://calk.uz/ru/calculator/internet"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит домашний интернет?","acceptedAnswer":{"@type":"Answer","text":"От 79 000 сум (30 Мбит/с) до 449 000 сум (1 Гбит/с) в месяц. Uztelecom GPON: от 89 000 (50 Мбит/с)."}},{"@type":"Question","name":"Какой интернет самый быстрый?","acceptedAnswer":{"@type":"Answer","text":"GPON-оптика (Uztelecom, TuronTelecom): до 1 Гбит/с. 5G (пилот в Ташкенте): до 1 Гбит/с. Мобильный 4G: до 150 Мбит/с."}},{"@type":"Question","name":"Какую скорость выбрать?","acceptedAnswer":{"@type":"Answer","