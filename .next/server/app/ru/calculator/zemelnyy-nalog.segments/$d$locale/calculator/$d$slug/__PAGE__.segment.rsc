2:T1f1b,[{"@context":"https://schema.org","@type":"WebPage","name":"Земельный налог","description":"Рассчитайте земельный налог для участков в Узбекистане. Учитывает категорию земли, площадь и местоположение.","url":"https://calk.uz/ru/calculator/zemelnyy-nalog","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/zemelnyy-nalog#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/zemelnyy-nalog/opengraph-image"},"dateModified":"2026-09-13"},{"@context":"https://schema.org","@type":"WebApplication","name":"Земельный налог","description":"Рассчитайте земельный налог для участков в Узбекистане. Учитывает категорию земли, площадь и местоположение.","url":"https://calk.uz/ru/calculator/zemelnyy-nalog","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/zemelnyy-nalog#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Налоги","item":"https://calk.uz/ru/category/tax"},{"@type":"ListItem","position":3,"name":"Земельный налог","item":"https://calk.uz/ru/calculator/zemelnyy-nalog"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Какая ставка земельного налога?","acceptedAnswer":{"@type":"Answer","text":"За сельхозземли — 0,95% нормативной стоимости. За остальные участки ставка в сумах за площадь: физлица — за 1 кв. м (в Ташкенте от 725 до 1 856 сум по зонам, в областях 297–463 сум), юрлица — за 1 гектар (в Ташкенте 65,9–319,0 млн сум, в областях 31,8–51,8 млн). К базовой ставке местные кенгаши применяют коэффициенты."}},{"@type":"Question","name":"Кто платит земельный налог?","acceptedAnswer":{"@type":"Answer","text":"Юридические и физические лица и дехканские хозяйства, у которых участок в собственности, владении, пользовании или аренде. Арендная плата за землю, арендованную у хокимията, приравнена к земельному налогу и считается по тем же ставкам (ст. 424, 433 НК)."}},{"@type":"Question","name":"Есть ли льготы по земельному налогу?","acceptedAnswer":{"@type":"Answer","text":"Для физлиц: Герои Узбекистана, СССР и Труда, кавалеры ордена Славы трёх степеней, инвалиды и участники войны, лица с инвалидностью I–II групп, одинокие пенсионеры, многодетные семьи, потерявшие кормильца, чернобыльцы (ст. 436 НК). Кроме многодетных семей — только по участку под ИЖС или дехканское хозяйство, один участок на выбор."}},{"@type":"Question","name":"Как узнать точную ставку для своего участка?","acceptedAnswer":{"@type":"Answer","text":"Её ежегодно до 10 января утверждает кенгаш района или города — по кварталам, массивам и махаллям. Физлицам налоговая считает налог сама и до 1 марта присылает извещение в my.soliq.uz, по СМС или в приложение; юрлицам ставки сообщает налоговая по месту нахождения участка."}},{"@type":"Question","name":"Когда платить земельный налог?","acceptedAnswer":{"@type":"Answer","text":"Физлица — равными долями до 15 апреля и 15 октября. Юрлица за несельхозземли — ежемесячно до 10-го числа (плательщики налога с оборота — ежеквартально до 20-го числа третьего месяца квартала), за сельхозземли — 30% до 1 сентября и остаток до 1 декабря. При просрочке начисляется пеня 1/300 ставки рефинансирования ЦБ в день (при ставке 14% — 0,047%/день)."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Земельный налог","description":"Рассчитайте земельный налог для участков в Узбекистане. Учитывает категорию земли, площадь и местоположение.","url":"https://calk.uz/ru/calculator/zemelnyy-nalog","datePublished":"2025-07-19","dateModified":"2026-09-13","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/zemelnyy-nalog"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Земельный налог","description":"Пошаговое руководство по использованию калькулятора: Земельный налог","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Выберите категорию земли и плательщика","text":"За сельхозземли налог — 0,95% нормативной стоимости; за остальные участки — ставка в сумах за площадь: у физлиц за 1 кв. м, у юрлиц за 1 гектар."},{"@type":"HowToStep","position":2,"name":"Укажите регион и площадь","text":"Выберите регион или зону Ташкента и введите площадь в кв. м, сотках или гектарах; для сельхозземель — нормативную стоимость угодий."},{"@type":"HowToStep","position":3,"name":"Проверьте коэффициент","text":"По умолчанию 1 — базовая ставка Налогового кодекса. Если знаете коэффициент местного кенгаша для вашего района или махалли, введите его."},{"@type":"HowToStep","position":4,"name":"Получите расчёт налога","text":"Результат появится сразу: базовая ставка, годовой налог и сроки уплаты — у физлиц равными долями до 15 апреля и 15 октября."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"MbArIfrPOMzJJrrY6NihS"}
