2:T178a,[{"@context":"https://schema.org","@type":"WebPage","name":"ОСАГО калькулятор","description":"Рассчитайте стоимость полиса ОСАГО в Узбекистане. Учитывает регион, стаж и мощность двигателя.","url":"https://calk.uz/ru/calculator/osago","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/osago#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/osago/opengraph-image"},"dateModified":"2026-09-13"},{"@context":"https://schema.org","@type":"WebApplication","name":"ОСАГО калькулятор","description":"Рассчитайте стоимость полиса ОСАГО в Узбекистане. Учитывает регион, стаж и мощность двигателя.","url":"https://calk.uz/ru/calculator/osago","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/osago#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Авто","item":"https://calk.uz/ru/category/auto"},{"@type":"ListItem","position":3,"name":"ОСАГО калькулятор","item":"https://calk.uz/ru/calculator/osago"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит ОСАГО в Узбекистане?","acceptedAnswer":{"@type":"Answer","text":"192 000 сум в Ташкенте при ограниченном круге водителей и 384 000 без ограничения; в других регионах 160 000 и 320 000. При одном ДТП по вине премия умножается на 1,3 — например, 249 600 сум вместо 192 000."}},{"@type":"Question","name":"Какой штраф за езду без ОСАГО?","acceptedAnswer":{"@type":"Answer","text":"Предупреждение или штраф 0,5 БРВ (220 000 сум) по ст. 135-1 КоАО — за езду в период, не покрытый полисом, или водителем, не вписанным в полис. Штраф 1 БРВ (440 000 сум) — по ст. 135 ч. 1, если полис есть, но не при себе; с ID-картой или биометрическим паспортом возить его не нужно."}},{"@type":"Question","name":"Какая максимальная выплата по ОСАГО?","acceptedAnswer":{"@type":"Answer","text":"За вред здоровью — до 52 млн сум. За вред имуществу — до 28 млн сум (общий лимит 80 млн)."}},{"@type":"Question","name":"Что такое коэффициент бонус-малус?","acceptedAnswer":{"@type":"Answer","text":"Множитель к базовому тарифу по числу ДТП по вине за прошлый период: 0 — 1,0; 1 — 1,3; 2 — 2,0; 3 и более — 3,0. Скидки за безаварийную езду в тарифе 2026 года нет — чистая история означает базовый тариф."}},{"@type":"Question","name":"Можно ли оформить ОСАГО онлайн?","acceptedAnswer":{"@type":"Answer","text":"Да, полис ОСАГО можно приобрести онлайн через сайты страховых компаний."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"ОСАГО калькулятор","description":"Рассчитайте стоимость полиса ОСАГО в Узбекистане. Учитывает регион, стаж и мощность двигателя.","url":"https://calk.uz/ru/calculator/osago","datePublished":"2025-09-13","dateModified":"2026-09-13","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/osago"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: ОСАГО калькулятор","description":"Пошаговое руководство по использованию калькулятора: ОСАГО калькулятор","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Выберите регион","text":"Ташкент и Ташкентская область или другие регионы — базовый тариф отличается."},{"@type":"HowToStep","position":2,"name":"Укажите круг водителей","text":"Отметьте, если полис без ограничения числа водителей — тариф выше."},{"@type":"HowToStep","position":3,"name":"Укажите число ДТП по вине","text":"От аварийности зависит коэффициент бонус-малус."},{"@type":"HowToStep","position":4,"name":"Получите стоимость полиса","text":"Результат появится сразу: базовый тариф, КБМ и годовая премия."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"MbArIfrPOMzJJrrY6NihS"}
