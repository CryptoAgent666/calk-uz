2:T1920,[{"@context":"https://schema.org","@type":"WebPage","name":"Больничный","description":"Рассчитайте оплату больничного листа. Зависит от стажа работы и среднего заработка сотрудника.","url":"https://calk.uz/ru/calculator/bolnichnyy","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/bolnichnyy#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/bolnichnyy/opengraph-image"},"dateModified":"2026-09-13"},{"@context":"https://schema.org","@type":"WebApplication","name":"Больничный","description":"Рассчитайте оплату больничного листа. Зависит от стажа работы и среднего заработка сотрудника.","url":"https://calk.uz/ru/calculator/bolnichnyy","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/bolnichnyy#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Зарплата","item":"https://calk.uz/ru/category/salary"},{"@type":"ListItem","position":3,"name":"Больничный","item":"https://calk.uz/ru/calculator/bolnichnyy"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Как оплачивается больничный?","acceptedAnswer":{"@type":"Answer","text":"В зависимости от страхового стажа: от 6 до 96 месяцев — 60%, от 97 месяцев (больше 8 лет) — 80% среднего заработка. Пособие = среднемесячный заработок ÷ 25,3 × процент × дни больничного без воскресений и праздников. Минимальный страховой стаж для получения выплат — 6 месяцев."}},{"@type":"Question","name":"Кто оплачивает больничный?","acceptedAnswer":{"@type":"Answer","text":"С 1 июля 2026 года: первые 5 календарных дней в году — работодатель, с 6-го дня — напрямую ГССФ (Государственный страховой социальный фонд)."}},{"@type":"Question","name":"Какой максимальный срок больничного?","acceptedAnswer":{"@type":"Answer","text":"До 182 календарных дней в год. При уходе за больным ребёнком лимит больше на 20 дней (ребёнок до 14 лет) или на 40 дней (ребёнок с инвалидностью до 16 лет). Далее решает МСЭК."}},{"@type":"Question","name":"Облагается ли больничный налогом?","acceptedAnswer":{"@type":"Answer","text":"Да, удерживается НДФЛ 12% (взнос ИНПС 0,1% входит в эти 12%). Социальный налог не начисляется."}},{"@type":"Question","name":"Как оплачивается больничный по уходу за ребёнком?","acceptedAnswer":{"@type":"Answer","text":"Как обычный больничный, но годовой лимит 182 дня увеличивается: на 20 календарных дней за ребёнка до 14 лет, на 40 — за ребёнка с инвалидностью до 16 лет."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Больничный","description":"Рассчитайте оплату больничного листа. Зависит от стажа работы и среднего заработка сотрудника.","url":"https://calk.uz/ru/calculator/bolnichnyy","datePublished":"2025-03-10","dateModified":"2026-09-13","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/bolnichnyy"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Больничный","description":"Пошаговое руководство по использованию калькулятора: Больничный","totalTime":"PT2M","step":[{"@type":"HowToStep","position":1,"name":"Введите заработок за 12 месяцев","text":"Укажите общую сумму заработка за последние 12 месяцев, а не среднемесячную зарплату. Если стаж меньше 12 месяцев — заработок за эти месяцы."},{"@type":"HowToStep","position":2,"name":"Укажите страховой стаж","text":"Стаж в месяцах: 6-96 месяцев — 60% среднего заработка, от 97 месяцев — 80%."},{"@type":"HowToStep","position":3,"name":"Укажите даты больничного","text":"Выберите дату начала и введите число календарных дней по больничному листу — воскресенья и праздники калькулятор исключит сам."},{"@type":"HowToStep","position":4,"name":"Получите расчёт","text":"Результат появится сразу: среднедневной заработок (÷ 25,3), оплачиваемые дни, процент, доли работодателя и Фонда, пособие и НДФЛ."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
