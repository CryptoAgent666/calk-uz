2:T18dd,[{"@context":"https://schema.org","@type":"WebPage","name":"Постановка авто на учёт: госпошлины","description":"Транспортного налога в Узбекистане нет. Считаем то, что платят реально — госпошлины при постановке автомобиля на учёт.","url":"https://calk.uz/ru/calculator/transportnyy-nalog","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/transportnyy-nalog#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/transportnyy-nalog/opengraph-image"},"dateModified":"2026-08-09"},{"@context":"https://schema.org","@type":"WebApplication","name":"Постановка авто на учёт: госпошлины","description":"Транспортного налога в Узбекистане нет. Считаем то, что платят реально — госпошлины при постановке автомобиля на учёт.","url":"https://calk.uz/ru/calculator/transportnyy-nalog","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/transportnyy-nalog#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Авто","item":"https://calk.uz/ru/category/auto"},{"@type":"ListItem","position":3,"name":"Постановка авто на учёт: госпошлины","item":"https://calk.uz/ru/calculator/transportnyy-nalog"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит транспортный налог в Узбекистане?","acceptedAnswer":{"@type":"Answer","text":"Нисколько — такого налога в Узбекистане не существует. Перечень налогов в статье 17 Налогового кодекса закрытый, транспортного налога в нём нет. Ежегодных платежей за владение автомобилем нет."}},{"@type":"Question","name":"Сколько стоит поставить машину на учёт?","acceptedAnswer":{"@type":"Answer","text":"13,04 БРВ = 5 737 600 сум при получении новых номеров: регистрация 6,84 БРВ, техпаспорт 0,7 БРВ, номера 5,5 БРВ. Со своими номерами — 7,54 БРВ (3 317 600 сум)."}},{"@type":"Question","name":"Облагаются ли электромобили?","acceptedAnswer":{"@type":"Answer","text":"Ежегодного налога нет ни для электромобилей, ни для машин с ДВС. При ввозе электромобиль освобождён от таможенной пошлины и акциза, но утилизационный сбор платит — 120 или 210 БРВ в зависимости от возраста."}},{"@type":"Question","name":"А до 15 апреля и 15 октября что тогда платят?","acceptedAnswer":{"@type":"Answer","text":"Это сроки уплаты налога на имущество и земельного налога физических лиц. Автомобиль не является объектом ни одного из них."}},{"@type":"Question","name":"Нужно ли платить при продаже автомобиля?","acceptedAnswer":{"@type":"Answer","text":"Ежегодного налога нет, поэтому делить его между продавцом и покупателем не нужно. Новый владелец платит госпошлину за перерегистрацию."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Постановка авто на учёт: госпошлины","description":"Транспортного налога в Узбекистане нет. Считаем то, что платят реально — госпошлины при постановке автомобиля на учёт.","url":"https://calk.uz/ru/calculator/transportnyy-nalog","datePublished":"2025-01-19","dateModified":"2026-08-09","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/transportnyy-nalog"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Постановка авто на учёт: госпошлины","description":"Пошаговое руководство по использованию калькулятора: Постановка авто на учёт: госпошлины","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Выберите тип ТС","text":"Легковой автомобиль, мотоцикл или прицеп — ставки госпошлины различаются."},{"@type":"HowToStep","position":2,"name":"Укажите, нужны ли новые номера","text":"При перерегистрации со своими номерами платёж меньше на 5,5 БРВ."},{"@type":"HowToStep","position":3,"name":"Получите расчёт","text":"Результат появится сразу — разовая госпошлина при постановке на учёт, в сумах и в БРВ."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8"],"$L9"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"tiXmGC5WDKODjdEEJHa70"}
