2:T192e,[{"@context":"https://schema.org","@type":"WebPage","name":"Калькулятор НДС","description":"Выделите или начислите НДС 12%. Быстрый расчёт суммы налога на добавленную стоимость для любых сумм.","url":"https://calk.uz/ru/calculator/nds","inLanguage":"ru","isPartOf":{"@type":"WebSite","name":"Calk.UZ","url":"https://calk.uz"},"breadcrumb":{"@id":"https://calk.uz/ru/calculator/nds#breadcrumb"},"primaryImageOfPage":{"@type":"ImageObject","url":"https://calk.uz/ru/calculator/nds/opengraph-image"},"dateModified":"2026-07-25"},{"@context":"https://schema.org","@type":"WebApplication","name":"Калькулятор НДС","description":"Выделите или начислите НДС 12%. Быстрый расчёт суммы налога на добавленную стоимость для любых сумм.","url":"https://calk.uz/ru/calculator/nds","applicationCategory":"FinanceApplication","operatingSystem":"All","offers":{"@type":"Offer","price":"0","priceCurrency":"UZS"},"inLanguage":"ru","publisher":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"}},{"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://calk.uz/ru/calculator/nds#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Главная","item":"https://calk.uz/ru"},{"@type":"ListItem","position":2,"name":"Налоги","item":"https://calk.uz/ru/category/tax"},{"@type":"ListItem","position":3,"name":"Калькулятор НДС","item":"https://calk.uz/ru/calculator/nds"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Какая ставка НДС в Узбекистане?","acceptedAnswer":{"@type":"Answer","text":"Стандартная ставка НДС составляет 12%. Экспорт облагается по ставке 0%."}},{"@type":"Question","name":"Как выделить НДС из суммы?","acceptedAnswer":{"@type":"Answer","text":"Разделите сумму с НДС на 112 и умножьте на 12. Формула: НДС = Сумма с НДС × 12 / 112. Например, из 1 120 000 сум НДС = 120 000 сум."}},{"@type":"Question","name":"Как начислить НДС на сумму?","acceptedAnswer":{"@type":"Answer","text":"Умножьте сумму без НДС на 0,12. Например, 1 000 000 × 0,12 = 120 000 сум НДС. Итого с НДС: 1 120 000 сум."}},{"@type":"Question","name":"Кто обязан платить НДС?","acceptedAnswer":{"@type":"Answer","text":"Юридические лица и ИП с совокупным доходом за налоговый период свыше 12 000 БРВ (5 280 000 000 сум при БРВ 440 000). Остальные могут зарегистрироваться добровольно."}},{"@type":"Question","name":"Какие товары и услуги освобождены от НДС?","acceptedAnswer":{"@type":"Answer","text":"Образовательные и медицинские услуги, финансовые услуги, аренда жилых помещений, ритуальные услуги, ряд продуктов питания."}},{"@type":"Question","name":"Как часто сдавать отчётность по НДС?","acceptedAnswer":{"@type":"Answer","text":"Ежемесячно — всем плательщикам, независимо от оборота: квартальный порядок отменён с 2022 года. Срок подачи и уплаты — до 20-го числа следующего месяца."}},{"@type":"Question","name":"Что такое упрощённый НДС 6%?","acceptedAnswer":{"@type":"Answer","text":"Добровольный режим для общепита, торговли и услуг (Указ № УП-100 от 26.05.2026, действует до 2030 года): НДС 6% со всего оборота по реализации и налог на прибыль 0%, но без права на зачёт входного НДС. Покупатель у такого поставщика зачёт при этом получает. Импорт — 12%, экспорт — 6%. Крупным налогоплательщикам и компаниям с госдолей от 50% режим недоступен."}}]},{"@context":"https://schema.org","@type":"TechArticle","headline":"Калькулятор НДС","description":"Выделите или начислите НДС 12%. Быстрый расчёт суммы налога на добавленную стоимость для любых сумм.","url":"https://calk.uz/ru/calculator/nds","datePublished":"2025-05-22","dateModified":"2026-07-25","author":{"@type":"Person","@id":"https://calk.uz/#founder","name":"Konstantin Yakovlev","alternateName":"Константин Яковлев","url":"https://calk.uz/ru/author/konstantin-yakovlev","jobTitle":"Основатель и руководитель проекта Calk.UZ","image":"https://calk.uz/og/author-konstantin.jpg"},"reviewedBy":{"@type":"Organization","name":"Calk.UZ","url":"https://calk.uz"},"publisher":{"@type":"Organization","@id":"https://calk.uz/#organization","name":"Calk.UZ","url":"https://calk.uz","logo":{"@type":"ImageObject","url":"https://calk.uz/favicon.svg"}},"inLanguage":"ru","mainEntityOfPage":"https://calk.uz/ru/calculator/nds"},{"@context":"https://schema.org","@type":"HowTo","name":"Как пользоваться: Калькулятор НДС","description":"Пошаговое руководство по использованию калькулятора: Калькулятор НДС","totalTime":"PT1M","step":[{"@type":"HowToStep","position":1,"name":"Введите сумму","text":"Укажите сумму, для которой нужно рассчитать НДС."},{"@type":"HowToStep","position":2,"name":"Выберите операцию","text":"Выберите «Начислить НДС» (добавить 12%) или «Выделить НДС» (извлечь из суммы)."},{"@type":"HowToStep","position":3,"name":"Получите результат","text":"Результат появится сразу: сумму НДС, сумму без НДС и сумму с НДС."}]}]0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5","$L6","$L7","$L8","$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"qEoiCRzEDSkMaVTFGrz6G"}
