# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google AdSense
NEXT_PUBLIC_ADSENSE_ID=ca-pub-4859241862365215

# Telegram Bot — request a token from @BotFather, set the chat ID via /start
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID

# DATA_HUB IAP-funnel telemetry — OPTIONAL, and normally left unset.
# The DATA_HUB receiver authenticates nothing (it guards itself with a
# four-type allowlist), so /api/iap-telemetry forwards regardless. Set this
# only if the receiver ever starts requiring a bearer token again.
# DATAHUB_TELEMETRY_TOKEN=
